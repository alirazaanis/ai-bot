{
  "name": "angela-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Angela MVP: Teams bot + Graph mail (governed draft/send) + Azure OpenAI",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "auth:mail": "tsx scripts/auth-mail.ts",
    "generate-icons": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "botbuilder": "^4.23.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "openai": "^4.73.0",
    "p-retry": "^6.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
