# =============================================================================
# DEMO-FIRST — copy to `.env` and add secrets (bot password, OpenAI key, etc.).
# Defaults below turn ON auto-reply mail + easy Teams replies. Tighten for
# production using docs/GOVERNANCE.md (mention-only, draft-only, allowlists).
# =============================================================================

# --- Bot Framework (Azure Bot / Teams) ---
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
PORT=3978

# --- Teams: false = reply to every message where the bot is installed (best for 1:1 / pilot chat). true = require @Angela in channels ---
ALLOWED_TENANT_IDS=
ALLOWED_TEAM_CHANNEL_KEYS=
TEAMS_REQUIRE_MENTION=false

# --- Mail: send = Graph sends the reply after building it (demo). draft = leave in Outlook drafts only ---
EMAIL_MODE=send
EMAIL_SEND_ENABLED=true
EMAIL_SEND_ALLOWLIST=
MAIL_FOLDER_WELL_KNOWN=inbox

# --- Inbox poller: ON by default for demo (same send rules as HTTP) ---
EMAIL_AUTO_REPLY_ENABLED=true
EMAIL_AUTO_POLL_INTERVAL_SEC=30
EMAIL_AUTO_POLL_MAX_BATCH=15
EMAIL_AUTO_REPLY_MAX_THREAD=12

LOG_MESSAGE_BODIES=false
LOG_LLM_IO=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_CONVERSATION=20

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Graph mail (delegated) — run: npm run auth:mail ---
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=common
GRAPH_AUTHORITY_HOST=https://login.microsoftonline.com
GRAPH_SCOPES="offline_access User.Read Mail.Read Mail.ReadWrite"

GRAPH_ACCESS_TOKEN=
